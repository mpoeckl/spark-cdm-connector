{
  "jsonSchemaSemanticVersion": "1.0.0",
  "imports": [
    {
      "corpusPath": "cdm:/foundations.cdm.json"
    }
  ],
  "definitions": [
    {
      "entityName": "SalesOrder",
      "extendsEntity": "CdmEntity",
      "explanation": "Sales order entity for testing Spark 3.5 CDM Connector",
      "hasAttributes": [
        {
          "name": "OrderId",
          "dataType": "integer",
          "dataFormat": "int32",
          "description": "Unique identifier for order",
          "appliedTraits": [
            {
              "traitReference": "is.identifiedBy"
            }
          ]
        },
        {
          "name": "CustomerId",
          "dataType": "integer",
          "dataFormat": "int32",
          "description": "Customer identifier"
        },
        {
          "name": "EmployeeId",
          "dataType": "integer",
          "dataFormat": "int32",
          "description": "Sales representative employee ID"
        },
        {
          "name": "OrderDate",
          "dataType": "date",
          "dataFormat": "date",
          "description": "Date order was placed"
        },
        {
          "name": "RequiredDate",
          "dataType": "date",
          "dataFormat": "date",
          "description": "Date order is required"
        },
        {
          "name": "ShippedDate",
          "dataType": "date",
          "dataFormat": "date",
          "description": "Date order was shipped"
        },
        {
          "name": "ShipVia",
          "dataType": "integer",
          "dataFormat": "int32",
          "description": "Shipping company ID"
        },
        {
          "name": "Freight",
          "dataType": "decimal",
          "dataFormat": "decimal",
          "description": "Shipping cost",
          "appliedTraits": [
            {
              "traitReference": "is.dataFormat.numeric.shaped",
              "arguments": [
                {
                  "name": "precision",
                  "value": "8"
                },
                {
                  "name": "scale",
                  "value": "2"
                }
              ]
            }
          ]
        },
        {
          "name": "ShipName",
          "dataType": "string",
          "dataFormat": "string",
          "description": "Ship to name",
          "maximumLength": 100
        },
        {
          "name": "ShipAddress",
          "dataType": "string",
          "dataFormat": "string",
          "description": "Ship to address",
          "maximumLength": 200
        },
        {
          "name": "ShipCity",
          "dataType": "string",
          "dataFormat": "string",
          "description": "Ship to city",
          "maximumLength": 50
        },
        {
          "name": "ShipRegion",
          "dataType": "string",
          "dataFormat": "string",
          "description": "Ship to region",
          "maximumLength": 50
        },
        {
          "name": "ShipPostalCode",
          "dataType": "string",
          "dataFormat": "string",
          "description": "Ship to postal code",
          "maximumLength": 10
        },
        {
          "name": "ShipCountry",
          "dataType": "string",
          "dataFormat": "string",
          "description": "Ship to country",
          "maximumLength": 50
        },
        {
          "name": "OrderTotal",
          "dataType": "decimal",
          "dataFormat": "decimal",
          "description": "Total order amount",
          "appliedTraits": [
            {
              "traitReference": "is.dataFormat.numeric.shaped",
              "arguments": [
                {
                  "name": "precision",
                  "value": "12"
                },
                {
                  "name": "scale",
                  "value": "2"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}