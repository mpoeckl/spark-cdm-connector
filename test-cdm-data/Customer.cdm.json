{
  "jsonSchemaSemanticVersion": "1.0.0",
  "imports": [
    {
      "corpusPath": "cdm:/foundations.cdm.json"
    }
  ],
  "definitions": [
    {
      "entityName": "Customer",
      "extendsEntity": "CdmEntity",
      "explanation": "Customer entity for testing Spark 3.5 CDM Connector",
      "hasAttributes": [
        {
          "name": "CustomerId",
          "dataType": "integer",
          "dataFormat": "int32",
          "description": "Unique identifier for customer",
          "appliedTraits": [
            {
              "traitReference": "is.identifiedBy"
            }
          ]
        },
        {
          "name": "CustomerName",
          "dataType": "string",
          "dataFormat": "string",
          "description": "Customer company name",
          "maximumLength": 100,
          "appliedTraits": [
            {
              "traitReference": "is.requiredAtLevel",
              "arguments": [
                {
                  "name": "level",
                  "value": "required"
                }
              ]
            }
          ]
        },
        {
          "name": "ContactEmail",
          "dataType": "string",
          "dataFormat": "string",
          "description": "Primary contact email",
          "maximumLength": 100
        },
        {
          "name": "Phone",
          "dataType": "string",
          "dataFormat": "string",
          "description": "Primary phone number",
          "maximumLength": 20
        },
        {
          "name": "Address",
          "dataType": "string",
          "dataFormat": "string",
          "description": "Street address",
          "maximumLength": 200
        },
        {
          "name": "City",
          "dataType": "string",
          "dataFormat": "string",
          "description": "City",
          "maximumLength": 50
        },
        {
          "name": "State",
          "dataType": "string",
          "dataFormat": "string",
          "description": "State or province",
          "maximumLength": 50
        },
        {
          "name": "PostalCode",
          "dataType": "string",
          "dataFormat": "string",
          "description": "Postal or ZIP code",
          "maximumLength": 10
        },
        {
          "name": "Country",
          "dataType": "string",
          "dataFormat": "string",
          "description": "Country",
          "maximumLength": 50
        },
        {
          "name": "CreditLimit",
          "dataType": "decimal",
          "dataFormat": "decimal",
          "description": "Customer credit limit",
          "appliedTraits": [
            {
              "traitReference": "is.dataFormat.numeric.shaped",
              "arguments": [
                {
                  "name": "precision",
                  "value": "12"
                },
                {
                  "name": "scale",
                  "value": "2"
                }
              ]
            }
          ]
        },
        {
          "name": "CustomerSince",
          "dataType": "date",
          "dataFormat": "date",
          "description": "Date customer was acquired"
        }
      ]
    }
  ]
}